# Nginx reverse proxy for dashboard.steez.digital -> Next.js on :3002
# Copy to /etc/nginx/sites-available/dashboard.steez.digital, symlink into
# sites-enabled, then `certbot --nginx -d dashboard.steez.digital`.

server {
    listen 80;
    server_name dashboard.steez.digital;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 10M; # allow product photo uploads through /api/upload
}
