// STEEZ multi-tenant dashboard — Phase 1 schema (Tenant/User) + full model set
// per plan: /Users/yxngsterx/.claude/plans/snoopy-roaming-zebra.md

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // "konlito" — public API path + CORS lookup
  name      String
  createdAt DateTime @default(now())

  // Publishing to the client's live static site. The public site is a static
  // export, so catalog edits only appear after a rebuild — this hook triggers
  // one on demand (see lib/publish.ts). Null until the owner pastes it in.
  deployHookUrl   String?
  lastPublishedAt DateTime?

  // SEO fields — in progress in a concurrent session as of 2026-09-24
  // (migration 20260909035151_seo_fields already applied to this shared dev
  // DB); restored here so schema.prisma matches the DB and `prisma generate`
  // doesn't drop these from the shared generated client underneath that work.
  baiduSiteToken          String?
  icpNumber               String?
  seoDefaultDescription   String?
  seoDefaultOgImagePath   String?
  seoOrganizationLogoPath String?
  seoOrganizationName     String?
  seoSiteName             String?
  seoTitleTemplate        String?
  siteUrl                 String?

  users         User[]
  categories    Category[]
  products      Product[]
  articles      Article[]
  guides        Guide[]
  productEvents ProductEvent[]
  pageViews     PageView[]
  auditLogs     AuditLog[]
  leads         Lead[]
}

enum Role {
  OWNER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  // TOTP 2FA. totpSecret is set as soon as enrollment starts but totpEnabled
  // stays false until the user confirms one valid code — so a half-finished
  // enrollment never locks anyone out. recoveryCodes are bcrypt-hashed,
  // single-use (consumed entries are removed from the array).
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  recoveryCodes String[] @default([])

  // Forgot-password flow. resetTokenHash is a SHA-256 digest of the token
  // emailed to the user (the raw token never touches the DB) — single-use,
  // cleared on success. resetTokenExpiresAt gates a 1-hour window.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  @@index([tenantId])
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  slug        String
  label       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // drives pending-change detection for publishing

  // SEO fields — see the matching note on Tenant above.
  noindex        Boolean @default(false)
  ogImagePath    String?
  seoDescription String?
  seoKeywords    String?
  seoTitle       String?

  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  slug        String // e.g. "k6602"
  model       String // display code, e.g. "K6602"
  name        String
  description String?
  imagePath   String? // OSS object key
  specs       Json? // mirrors Record<string,string> in Konlito's lib/products.ts
  sortOrder   Int       @default(0)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // SEO fields — see the matching note on Tenant above.
  canonicalUrl   String?
  imageAlt       String?
  noindex        Boolean @default(false)
  ogImagePath    String?
  seoDescription String?
  seoKeywords    String?
  seoTitle       String?

  finishes      ProductFinish[]
  productEvents ProductEvent[]
  images        ProductImage[]
  models3d      ProductModel3D[]
  leads         Lead[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imagePath String // OSS key
  alt       String? // SEO field — see the matching note on Tenant above.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductModel3D {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  modelPath String // OSS key, .glb
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductFinish {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key           String // matches Konlito's Finish.key
  materialLabel String // matches Finish.material
  imagePath     String // OSS key, matches Finish.img
  accentHex     String // matches Finish.accent
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([productId, key])
  @@index([productId])
}

enum ArticleCategory {
  EDUCATION
  INDUSTRY
  COMPANY
}

// News/blog entries. bodyEn/bodyZh are Markdown prose, not structured blocks
// like Guide — news copy is prose, and no rich-text editor exists anywhere in
// this codebase yet, so a plain textarea authoring Markdown is the fit.
model Article {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  slug              String
  titleEn           String
  titleZh           String?
  standfirstEn      String?
  standfirstZh      String?
  bodyEn            String?
  bodyZh            String?
  metaTitleEn       String?
  metaTitleZh       String?
  metaDescriptionEn String?
  metaDescriptionZh String?
  primaryKeyword    String?
  secondaryKeywords String? // comma-separated, matches SEO-PLAN.md's table
  category          ArticleCategory @default(EDUCATION)
  imagePath         String? // OSS key
  imageAltEn        String?
  imageAltZh        String?
  sortOrder         Int             @default(0)
  featured          Boolean         @default(false)
  published         Boolean         @default(true)
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

enum GuideReader {
  DISTRIBUTOR
  CUSTOMER
  BOTH
}

// Buyer guides (komibright's /information, "Resources" in nav). Body is
// structured blocks (see GuideBlock) rather than prose, because the site
// renders a live capacity-figures table inline with the written blocks —
// that table can't be authored content, only a marker for where it goes.
model Guide {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  slug         String
  reader       GuideReader @default(BOTH)
  titleEn      String
  titleZh      String?
  standfirstEn String?
  standfirstZh String?
  minutes      Int         @default(5)
  imagePath    String? // OSS key
  imageAltEn   String?
  imageAltZh   String?
  sortOrder    Int         @default(0)
  published    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  blocks GuideBlock[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

enum GuideBlockKind {
  P
  H
  LIST
  TABLE // marker only — site renders the live capacity table here, no stored content
}

model GuideBlock {
  id        String         @id @default(cuid())
  guideId   String
  guide     Guide          @relation(fields: [guideId], references: [id], onDelete: Cascade)
  kind      GuideBlockKind
  textEn    String? // P/H kinds
  textZh    String?
  itemsEn   Json? // LIST kind only — string[]
  itemsZh   Json?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([guideId])
}

enum ProductEventType {
  VIEW
  CLICK
}

model ProductEvent {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  productId String?
  product   Product?         @relation(fields: [productId], references: [id])
  finishKey String?
  eventType ProductEventType
  sessionId String
  path      String?
  referrer  String?
  createdAt DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@index([productId, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  path      String
  sessionId String
  referrer  String?
  userAgent String?
  country   String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([path, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  ARCHIVED
}

// A buyer enquiry captured from the client's public site. This is the payoff
// of the analytics data: not "23 clicks" but "this person, this product,
// this message — follow up". Written by the unauthenticated public endpoint
// app/api/public/[tenantSlug]/lead/route.ts.
model Lead {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  // Which product they were looking at, when the site sends it. Nullable:
  // a general contact-page enquiry has no product context.
  productId String?
  product   Product?   @relation(fields: [productId], references: [id])
  name      String?
  email     String?
  phone     String?
  company   String?
  message   String?
  status    LeadStatus @default(NEW)
  notes     String? // internal follow-up notes, never shown publicly
  // Same anonymous id as PageView/ProductEvent, so a lead can be tied back
  // to what that visitor browsed before enquiring.
  sessionId String?
  path      String?
  referrer  String?
  country   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  userEmail String?
  action    String // e.g. "product.create", "team.remove"
  entity    String // e.g. "product", "category", "user"
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Sliding-window rate limiting backed by Postgres (no Redis dependency).
// One row per hit; checkRateLimit() counts rows in the window and prunes
// old ones for the same key on each check, so the table stays small.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String // e.g. "login:owner@konlito.com", "track:1.2.3.4"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
