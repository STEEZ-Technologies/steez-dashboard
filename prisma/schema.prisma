// STEEZ multi-tenant dashboard — Phase 1 schema (Tenant/User) + full model set
// per plan: /Users/yxngsterx/.claude/plans/snoopy-roaming-zebra.md

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // "konlito" — public API path + CORS lookup
  name      String
  createdAt DateTime @default(now())

  // Publishing to the client's live static site. The public site is a static
  // export, so catalog edits only appear after a rebuild — this hook triggers
  // one on demand (see lib/publish.ts). Null until the owner pastes it in.
  deployHookUrl   String?
  lastPublishedAt DateTime?

  // SEO fields — in progress in a concurrent session as of 2026-09-24
  // (migration 20260909035151_seo_fields already applied to this shared dev
  // DB); restored here so schema.prisma matches the DB and `prisma generate`
  // doesn't drop these from the shared generated client underneath that work.
  baiduSiteToken          String?
  icpNumber               String?
  seoDefaultDescription   String?
  seoDefaultOgImagePath   String?
  seoOrganizationLogoPath String?
  seoOrganizationName     String?
  seoSiteName             String?
  seoTitleTemplate        String?
  siteUrl                 String?

  users         User[]
  categories    Category[]
  products      Product[]
  articles      Article[]
  guides        Guide[]
  manualFacts   ManualFact[]
  productEvents ProductEvent[]
  pageViews     PageView[]
  auditLogs     AuditLog[]
  leads         Lead[]
  revisions     Revision[]
}

enum Role {
  OWNER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  name         String? // display name shown in the dashboard; login stays the email
  avatarPath   String? // profile picture, OSS object key
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  // TOTP 2FA. totpSecret is set as soon as enrollment starts but totpEnabled
  // stays false until the user confirms one valid code — so a half-finished
  // enrollment never locks anyone out. recoveryCodes are bcrypt-hashed,
  // single-use (consumed entries are removed from the array).
  totpSecret    String?
  totpEnabled   Boolean  @default(false)
  recoveryCodes String[] @default([])

  // Forgot-password flow. resetTokenHash is a SHA-256 digest of the token
  // emailed to the user (the raw token never touches the DB) — single-use,
  // cleared on success. resetTokenExpiresAt gates a 1-hour window.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  @@index([tenantId])
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  slug        String
  label       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // drives pending-change detection for publishing

  // SEO fields — see the matching note on Tenant above.
  noindex        Boolean @default(false)
  ogImagePath    String?
  seoDescription String?
  seoKeywords    String?
  seoTitle       String?

  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

enum ProductKind {
  MACHINE
  ACCESSORY
}

enum ProductUseCase {
  KITCHEN
  HOSPITALITY
  LAB
  MOBILE
}

enum ProductWaterSource {
  MAINS
  OPEN
}

enum ProductDispensing {
  TANK
  JAR
  DIRECT
}

model Product {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  slug          String // e.g. "k6602"
  model         String // display code, e.g. "K6602"
  name          String
  nameZh        String?
  description   String?
  descriptionZh String?
  // kind/useCases: komibright's catalogue browser facets — machine vs
  // accessory, and which use-case scenes a product belongs to. Optional
  // defaults keep Konlito's existing products unaffected (kind defaults to
  // MACHINE since Konlito has no accessory concept; useCases defaults empty).
  kind          ProductKind      @default(MACHINE)
  useCases      ProductUseCase[]
  imagePath     String? // OSS object key
  specs         Json? // mirrors Record<string,string> in Konlito's lib/products.ts
  sortOrder     Int              @default(0)
  featured      Boolean          @default(false)
  published     Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // SEO fields — see the matching note on Tenant above.
  canonicalUrl   String?
  imageAlt       String?
  noindex        Boolean @default(false)
  ogImagePath    String?
  seoDescription String?
  seoKeywords    String?
  seoTitle       String?

  finishes      ProductFinish[]
  productEvents ProductEvent[]
  images        ProductImage[]
  models3d      ProductModel3D[]
  contents      ProductContent[]
  fit           ProductFit?
  leads         Lead[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
}

// Box contents ("what's in the box"), bilingual, ordered — mirrors
// ProductImage's shape. Optional per product; komibright's finder/catalogue
// only shows this list when it's non-empty.
model ProductContent {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  textEn    String
  textZh    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// Structured capacity/pressure/source facts (komibright's finder.ts `FIT`).
// Every field is nullable on purpose: null means "catalogue doesn't say,"
// never a guessed value — the finder and product page both depend on that
// distinction (an unpublished pressure figure says so explicitly rather than
// implying it was checked). One row per machine; accessories never get one.
model ProductFit {
  id           String               @id @default(cuid())
  productId    String               @unique
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  litresPerDay Int?
  // Float, not Int: the catalogue's real minimums are fractional (1.5, 1.8
  // bar) — an Int column silently truncated them (caught 2026-09-28 via the
  // public API returning 1 instead of KB-C25R's real 1.5).
  minBar       Float?
  sources      ProductWaterSource[]
  dispensing   ProductDispensing    @default(TANK)
  powered      Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imagePath String // OSS key
  alt       String? // SEO field — see the matching note on Tenant above.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductModel3D {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  modelPath String // OSS key, .glb
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductFinish {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key           String // matches Konlito's Finish.key
  materialLabel String // matches Finish.material
  imagePath     String // OSS key, matches Finish.img
  accentHex     String // matches Finish.accent
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([productId, key])
  @@index([productId])
}

// Matches komibright-v2's real lib/articles.ts TOPICS list (minus the
// synthetic "all" filter, which stays a site-side UI concept). Replaces the
// EDUCATION/INDUSTRY/COMPANY ArticleCategory this model briefly had — that
// enum didn't match anything the real site reads.
enum ArticleTopic {
  REVERSE_OSMOSIS
  CHOOSING
  MAINTENANCE
  WATER_QUALITY
  SUSTAINABILITY
  COMPANY
}

// News/blog entries. Body is structured blocks (see ArticleBlock), not
// Markdown prose — komibright's real articles are p/h2/ul blocks, the same
// shape Guide already uses, so this reuses GuideBlockKind rather than
// inventing a second near-identical enum.
model Article {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  slug         String
  titleEn      String
  titleZh      String?
  standfirstEn String? // doubles as the meta description — komibright prints no separate one
  standfirstZh String?
  metaTitleEn  String?
  metaTitleZh  String?
  keywordsEn   String[]
  keywordsZh   String[]
  topic        ArticleTopic @default(COMPANY)
  imagePath    String? // OSS key
  imageAltEn   String?
  imageAltZh   String?
  sortOrder    Int          @default(0)
  published    Boolean      @default(true)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  blocks ArticleBlock[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model ArticleBlock {
  id        String         @id @default(cuid())
  articleId String
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  kind      GuideBlockKind // P/H/LIST used; TABLE never chosen for an article
  textEn    String? // P/H kinds
  textZh    String?
  itemsEn   Json? // LIST kind only — string[]
  itemsZh   Json?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([articleId])
}

enum GuideReader {
  DISTRIBUTOR
  CUSTOMER
  BOTH
}

// Buyer guides (komibright's /information, "Resources" in nav). Body is
// structured blocks (see GuideBlock) rather than prose, because the site
// renders a live capacity-figures table inline with the written blocks —
// that table can't be authored content, only a marker for where it goes.
model Guide {
  id                    String      @id @default(cuid())
  tenantId              String
  tenant                Tenant      @relation(fields: [tenantId], references: [id])
  slug                  String
  reader                GuideReader @default(BOTH)
  titleEn               String
  titleZh               String?
  standfirstEn          String?
  standfirstZh          String?
  minutes               Int         @default(5)
  imagePath             String? // OSS key — fallback image when no per-reader override is set
  imageAltEn            String?
  imageAltZh            String?
  // Per-reader image overrides (lib/resources.ts's `imageFor`). Optional —
  // most guides only ever set imagePath and never these.
  imageDistributorPath  String?
  imageDistributorAltEn String?
  imageDistributorAltZh String?
  imageCustomerPath     String?
  imageCustomerAltEn    String?
  imageCustomerAltZh    String?
  sortOrder             Int         @default(0)
  published             Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  blocks GuideBlock[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

enum GuideBlockKind {
  P
  H
  LIST
  TABLE // marker only — site renders the live capacity table here, no stored content
}

model GuideBlock {
  id        String         @id @default(cuid())
  guideId   String
  guide     Guide          @relation(fields: [guideId], references: [id], onDelete: Cascade)
  kind      GuideBlockKind
  textEn    String? // P/H kinds
  textZh    String?
  itemsEn   Json? // LIST kind only — string[]
  itemsZh   Json?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([guideId])
}

// The only two manualFacts.ts groups actually read by the live site — feed
// TDS/membrane element, and the two service intervals. The rest of
// manualFacts.ts (OPERATING_LIMITS, SPARE_CODES, RATED_FIGURES, WARRANTY,
// CONSUMABLES) is confirmed dead outside prototypes and is deliberately not
// modeled here.
enum ManualFactKey {
  FEED_TDS
  FEED_MEMBRANE
  SERVICE_COMBO_FILTER
  SERVICE_MEMBRANE
}

model ManualFact {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  key       ManualFactKey
  valueEn   String
  valueZh   String?
  noteEn    String?
  noteZh    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

enum ProductEventType {
  VIEW
  CLICK
}

model ProductEvent {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  productId String?
  product   Product?         @relation(fields: [productId], references: [id])
  finishKey String?
  eventType ProductEventType
  sessionId String
  path      String?
  referrer  String?
  createdAt DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@index([productId, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  path      String
  sessionId String
  referrer  String?
  userAgent String?
  country   String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([path, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  ARCHIVED
}

// A buyer enquiry captured from the client's public site. This is the payoff
// of the analytics data: not "23 clicks" but "this person, this product,
// this message — follow up". Written by the unauthenticated public endpoint
// app/api/public/[tenantSlug]/lead/route.ts.
model Lead {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  // Which product they were looking at, when the site sends it. Nullable:
  // a general contact-page enquiry has no product context.
  productId String?
  product   Product?   @relation(fields: [productId], references: [id])
  name      String?
  email     String?
  phone     String?
  company   String?
  message   String?
  status    LeadStatus @default(NEW)
  notes     String? // internal follow-up notes, never shown publicly
  // Same anonymous id as PageView/ProductEvent, so a lead can be tied back
  // to what that visitor browsed before enquiring.
  sessionId String?
  path      String?
  referrer  String?
  country   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  userEmail String?
  action    String // e.g. "product.create", "team.remove"
  entity    String // e.g. "product", "category", "user"
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Version history for catalogue content. One row holds the full state of an
// item (scalars plus its child rows) as it was *just before* a change, so the
// published version of an item is its first revision created after
// Tenant.lastPublishedAt, and restoring any row puts the item back exactly.
// Written by lib/revisions.ts; AuditLog above records only that a change
// happened, never the old values.
model Revision {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  entity    String // "product" | "article" | "guide" | "category"
  entityId  String
  label     String // the item's name at the time, so a deleted item can still be listed
  action    String // what was about to happen: "update" | "delete" | "restore" | "child"
  snapshot  Json
  userId    String?
  userEmail String?
  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId, createdAt])
  @@index([tenantId, action, createdAt])
}

// Sliding-window rate limiting backed by Postgres (no Redis dependency).
// One row per hit; checkRateLimit() counts rows in the window and prunes
// old ones for the same key on each check, so the table stays small.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String // "<prefix>:<hmac>" — the identifying part is hashed, see lib/rate-limit.ts
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
