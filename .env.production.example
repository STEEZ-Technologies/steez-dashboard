# Set these as Environment Variables in the Vercel project settings —
# never commit real values.

# Vercel Postgres (Storage tab) — use the NON-POOLING connection string.
# This app reads a single DATABASE_URL for both migrations and runtime
# queries; the pooled/pgbouncer URL can trip up Prisma's prepared statements.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Generate fresh for prod: openssl rand -base64 32
AUTH_SECRET=""

# Alibaba Cloud OSS — same bucket pattern as Konlito's CHINA-DEPLOY.md.
OSS_REGION="oss-cn-hongkong"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
ASSET_BASE_URL=""

# CORS allowlist for /api/public/*/track — Konlito's real origin(s), comma-separated.
PUBLIC_ALLOWED_ORIGINS="https://konlito.steez.digital"
